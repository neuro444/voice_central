# Existing Cake World backend used by the migrated dashboard screens.
NEXT_PUBLIC_API_URL=https://cakeworld.neuroheart.ai

# Telephony API used by Kitchen Orders (`/orders/recent`). In production this
# is the same public origin, so the browser does not need a cross-origin call.
NEXT_PUBLIC_TELEPHONY_URL=https://cakeworld.neuroheart.ai

# Empty means same-origin `/print/order`, which nginx routes to the established
# printer service and remote queue.
NEXT_PUBLIC_PRINT_API_URL=

# Dashboard login. Use a unique production password and a random secret of at
# least 16 characters; never commit the real values.
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_SESSION_SECRET=
